## 默认请求后端接口的前缀,方便做代理或nginx配置(一般无需调整), 如果前后端不分离请去掉 VITE_API_PREFIX=
VITE_API_PREFIX=/api
## 本地调试请求后端服务的接口地址(生产环境无效)
VITE_BASE_URL=http://localhost:10086/
## 省市县默认省份
VITE_AREA_PROVINCE=330000
## 高德地图配置
VITE_MAP_KEY=83f63344590d87e196e12b87f7fad15a
VITE_MAP_SECRET=d1a3a21ed7b6ab306b43211f4a9336d8
## 高德地图默认经度
VITE_MAP_LNG=120.183555
## 高德地图默认纬度
VITE_MAP_LAT=30.220532
## 高德地图默认缩放级别
VITE_MAP_ZOOM=18
## 微信小程序appId
VITE_APP_ID=wx0f0b0f0f0f0f0f0f
## 零售商品微信小程序短链接地址 (注意:如果没有电商平台、商家自营、跨境电商类目,建议切使用加密链接方式生成)
VITE_ITEM_SHORT_URL='/pages/index/index?itemId='
## 优惠券领取微信小程序短链接地址
VITE_COUPON_SHORT_URL='/pages/index/index?couponId='
## 餐饮桌码跳转地址
VITE_RESTAURANT_TABLE_URL='/pages/index/index'
## 餐饮桌码跳转参数,该参数可自行调整,在小程序端需要按此处定义规则进行解析。提示:id=店铺id, num=为桌号。
## 注意: 该参数长度>=32位时,小程序端需要调用/webapp/wechat/ma/scene?scene=接口进行解析
VITE_RESTAURANT_TABLE_PARAM='id={0}&num={1}'
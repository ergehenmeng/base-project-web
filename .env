## 默认请求后端接口的前缀,方便做代理或nginx配置(一般无需调整)
VITE_API_PREFIX=/api
## 本地调试请求后端服务的接口地址(生产环境无效)
VITE_BASE_URL=http://localhost:10086/
## 省市县默认省份
VITE_AREA_PROVINCE=330000
## 高德地图配置
VITE_MAP_KEY=83f63344590d87e196e12b87f7fad15a
VITE_MAP_SECRET=d1a3a21ed7b6ab306b43211f4a9336d8
## 高德地图默认经度
VITE_MAP_LNG=120.183555
## 高德地图默认纬度
VITE_MAP_LAT=30.220532
## 高德地图默认缩放级别
